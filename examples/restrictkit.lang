-- Part R laws by refl (docs/PLAN.md section 8). e1 is the lock end of alice
-- and bob (86500), so the lock-up passes there.
def e1 : Env := makeEnv 86500 86500u testToken selfAddr
def s3 : State := step s2 e1 (transfer alice bob 5u)
def s4 : State := step s2 e1 (mint carol 1u)
def dave : Addr := 0x00000000000000000000000000000000000000dd

-- L1: the bit of canTransfer is the product of the test bits.
def bitYes : Path Flag (canTransfer e1 s2 alice bob 2u)
  (both (holderCap s2 e1 (transfer alice bob 2u)) (both (classCap s2 e1 (transfer alice bob 2u))
    (both (countryIn s2 e1 (transfer alice bob 2u)) (lockUp s2 e1 (transfer alice bob 2u))))) := refl
def bitNo : Path Flag (canTransfer e1 s4 alice dave 1u)
  (both (holderCap s4 e1 (transfer alice dave 1u)) (both (classCap s4 e1 (transfer alice dave 1u))
    (both (countryIn s4 e1 (transfer alice dave 1u)) (lockUp s4 e1 (transfer alice dave 1u))))) := refl
def bitIsNo : Path Flag (canTransfer e1 s4 alice dave 1u) flagNo := refl
def bitNoCap : Path Flag (canTransfer e1 s2 alice carol 2u)
  (both (holderCap s2 e1 (transfer alice carol 2u)) (both (classCap s2 e1 (transfer alice carol 2u))
    (both (countryIn s2 e1 (transfer alice carol 2u)) (lockUp s2 e1 (transfer alice carol 2u))))) := refl
def bitIsYes : Path Flag (canTransfer e1 s2 alice bob 2u) flagYes := refl
-- L1 (Q-S7-2 (a)): allowed.bit is the flagIf of the tests, and it is the
-- first bit of allowed.dec.
def bitDecYes : Path Flag (allowed.bit s2 e1 (transfer alice bob 2u))
  (allowed.bitOf (allowed s2 e1 (transfer alice bob 2u)) (allowed.dec s2 e1 (transfer alice bob 2u))) := refl
