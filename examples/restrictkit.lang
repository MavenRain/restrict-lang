def fullState : State := setKey partialState (slot 0u 1u) 1u 2u
def fullSig : List U256 := zkSignAt (ring fullState 0u) 1u 256u (addrToU256 dave)
def fullBoundYes : Path Flag (ringBound fullState partialEnv 0u) flagYes := refl
def fullAccepted : Path Flag (regOk fullState partialEnv 0u fullSig (first partialImg) (second partialImg)) flagYes := refl

