-- restrict-lang S7 (Q-S7-1 (a)): the kit form of examples/restrict.lang,
-- built by `langc --kit build` (the daokit route). Part T (section 3.2): the
-- token moves and the binding entries. Part R (section 3.3): the hooks call
-- stepT, stepM and stepB directly (Q-S7-2 (a)). The kit lowers a mapGet of a
-- state field only, so stepT writes holdersIn by dropOver and the class cap
-- reads the word form classAfterT. Part C (section 3.4): isVerified, register
-- and issue over the state ring. selfWord is the Env word self (Q-S7-6 (a)),
-- and issue checks that the counter hc below K = 8 gives the H_p point of the
-- key (Q-S7-5 (a), Q-S7-13 (a)). On the chain, H_p is a loop of K tries
-- (Q-S7-14 (e1)). Part G (the DAO entries) is slice s4: the Part G words keep
-- init.

-- A move: a transfer, a mint or a burn. A program cannot declare a family
-- (REFUSE_DATA), so Move is a Sum alias with one helper for each constructor.
def Move : Type 0 := Sum (Prod Addr (Prod Addr U256)) (Sum (Prod Addr U256) (Prod Addr U256))
def transfer : Addr -> Addr -> U256 -> Move :=
  fun (f : Addr) (t : Addr) (x : U256) => inl (pair f (pair t x))
def mint : Addr -> U256 -> Move := fun (t : Addr) (x : U256) => inr (inl (pair t x))
def burn : Addr -> U256 -> Move := fun (f : Addr) (x : U256) => inr (inr (pair f x))

-- The mirror state: the balances, the holder count, the holders of each class
-- code, the lock ends, the bound token and the token that the DAO decided to
-- bind (Q-S3-2 (a): init sets it until S6). Part C (Q-S5-4 (a), Q-S5-5 (a)):
-- the used key images, the class code and the end of each registration, and
-- the two coordinates of each ring slot. Part G (Q-S6-2 (a), Q-S6-4 (a),
-- Q-S6-5 (a)): the four Params words, the issuer map and the class pass set.
state State := makeState (bal : Map Addr U256) (holders : U256) (holdersIn : Map U256 U256) (lockEnd : Map Addr Nat) (bound : Addr) (decided : Addr) (used : Map U256 Flag) (clsOf : Map Addr U256) (expires : Map Addr Nat) (ringX : Map U256 U256) (ringY : Map U256 U256) (pCapN : U256) (pCapCN : U256) (pLockD : Nat) (pRegD : Nat) (issuers : Map Addr Flag) (passCls : Map U256 Flag) (dao : Addr)

def noAddr : Addr := 0x0000000000000000000000000000000000000000
def testToken : Addr := 0x00000000000000000000000000000000000000ee
-- issuer0 is the S5 issuer. init holds the S4 and S5 values: the caps 2u
-- and 3u, the lock length 86400 s, the registration length 31536000 s, the
-- issuer issuer0 and the pass of class 0. A DAO decision changes them.
def issuer0 : Addr := 0x00000000000000000000000000000000000000e1
-- Q-S7-15 (a): the dao field is the address that can call the setters. In S7
-- s5 it is the address of restrictdao.
def daoAddr : Addr := 0x00000000000000000000000000000000000000da
def init : State :=
  makeState mapEmpty 0u mapEmpty mapEmpty noAddr testToken mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty
    2u 3u 86400 31536000 (mapSet mapEmpty issuer0 flagYes) (mapSet mapEmpty 0u flagYes) daoAddr

-- Q-S3-1 (a), Q-S5-6 (a): the class code of an address is its clsOf entry.
-- An address that did not register has class 0.
def clsCode : State -> Addr -> U256 := fun (s : State) (a : Addr) => mapGet (clsOf s) a

def both : Flag -> Flag -> Flag := fun (a : Flag) (b : Flag) => flagIf a b flagNo
def notF : Flag -> Flag := fun (a : Flag) => flagIf a flagNo flagYes
def inc : U256 -> Flag -> U256 := fun (n : U256) (c : Flag) => flagIf c (u256Add n 1u) n
def dec : U256 -> Flag -> U256 := fun (n : U256) (c : Flag) => flagIf c (u256Sub n 1u) n
def bump : Map U256 U256 -> U256 -> Flag -> Map U256 U256 :=
  fun (m : Map U256 U256) (k : U256) (c : Flag) => mapSet m k (inc (mapGet m k) c)
def drop : Map U256 U256 -> U256 -> Flag -> Map U256 U256 :=
  fun (m : Map U256 U256) (k : U256) (c : Flag) => mapSet m k (dec (mapGet m k) c)
def later : Nat -> Nat -> Nat := fun (a : Nat) (b : Nat) => flagIf (natLe a b) b a
-- The word forms of bump and drop (S7). bumpAt v k q c is the count at q
-- after bump at k, when v is the count at q before it (dropAt: drop).
-- dropOver m kt g kf l is drop (bump m kt g) kf l with each mapGet on m.
def bumpAt : U256 -> U256 -> U256 -> Flag -> U256 :=
  fun (v : U256) (k : U256) (q : U256) (c : Flag) => flagIf (u256Eq k q) (inc v c) v
def dropAt : U256 -> U256 -> U256 -> Flag -> U256 :=
  fun (v : U256) (k : U256) (q : U256) (c : Flag) => flagIf (u256Eq k q) (dec v c) v
def dropOver : Map U256 U256 -> U256 -> Flag -> U256 -> Flag -> Map U256 U256 :=
  fun (m : Map U256 U256) (kt : U256) (g : Flag) (kf : U256) (l : Flag) =>
    mapSet (bump m kt g) kf (dec (bumpAt (mapGet m kf) kt kf g) l)

-- The zero crossings (L6). gains b x: a balance b that gets x > 0 goes from 0
-- to more than 0. loses b x: a balance b > 0 that gives x goes to 0.
def gains : U256 -> U256 -> Flag := fun (b : U256) (x : U256) => both (notF (u256Eq x 0u)) (u256Eq b 0u)
def loses : U256 -> U256 -> Flag := fun (b : U256) (x : U256) => both (notF (u256Eq b 0u)) (u256Le b x)

-- A transfer. When f == t, no field changes. When x == 0, no count changes.
def stepT : State -> Addr -> Addr -> U256 -> State :=
  fun (s : State) (f : Addr) (t : Addr) (x : U256) =>
    makeState
      (mapSet (mapSet (bal s) f (flagIf (addrEq f t) (mapGet (bal s) f) (u256Sub (mapGet (bal s) f) x)))
        t (flagIf (addrEq f t) (mapGet (bal s) t) (u256Add (mapGet (bal s) t) x)))
      (dec (inc (holders s) (both (notF (addrEq f t)) (gains (mapGet (bal s) t) x)))
        (both (notF (addrEq f t)) (loses (mapGet (bal s) f) x)))
      (dropOver (holdersIn s) (clsCode s t) (both (notF (addrEq f t)) (gains (mapGet (bal s) t) x))
        (clsCode s f) (both (notF (addrEq f t)) (loses (mapGet (bal s) f) x)))
      (lockEnd s) (bound s) (decided s)
      (used s) (clsOf s) (expires s) (ringX s) (ringY s)
      (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s) (dao s)

-- A mint. A mint of x > 0 moves the lock end of t to the later of the two
-- times (Q7 (a)). The lock length is the state word pLockD (Q-S6-2 (a)). A
-- mint of 0 changes nothing.
def stepM : State -> Env -> Addr -> U256 -> State :=
  fun (s : State) (e : Env) (t : Addr) (x : U256) =>
    makeState
      (mapSet (bal s) t (u256Add (mapGet (bal s) t) x))
      (inc (holders s) (gains (mapGet (bal s) t) x))
      (bump (holdersIn s) (clsCode s t) (gains (mapGet (bal s) t) x))
      (mapSet (lockEnd s) t (flagIf (u256Eq x 0u) (mapGet (lockEnd s) t) (later (mapGet (lockEnd s) t) (natAdd (now e) (pLockD s)))))
      (bound s) (decided s)
      (used s) (clsOf s) (expires s) (ringX s) (ringY s)
      (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s) (dao s)

-- A burn.
def stepB : State -> Addr -> U256 -> State :=
  fun (s : State) (f : Addr) (x : U256) =>
    makeState
      (mapSet (bal s) f (u256Sub (mapGet (bal s) f) x))
      (dec (holders s) (loses (mapGet (bal s) f) x))
      (drop (holdersIn s) (clsCode s f) (loses (mapGet (bal s) f) x))
      (lockEnd s) (bound s) (decided s)
      (used s) (clsOf s) (expires s) (ringX s) (ringY s)
      (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s) (dao s)

-- The hook effect: balances, counts and lock ends.
def step : State -> Env -> Move -> State :=
  fun (s : State) (e : Env) (m : Move) =>
    either (fun (p : Prod Addr (Prod Addr U256)) => stepT s (first p) (first (second p)) (second (second p)))
      (fun (q : Sum (Prod Addr U256) (Prod Addr U256)) =>
        either (fun (p : Prod Addr U256) => stepM s e (first p) (second p))
          (fun (p : Prod Addr U256) => stepB s (first p) (second p)) q)
      m

-- L9: a token is bound and the caller is that token.
def fromToken : State -> Env -> Flag :=
  fun (s : State) (e : Env) => both (notF (addrEq (bound s) noAddr)) (addrEq (caller e) (bound s))

-- Part R. Q-S6-2 (a): the caps are the state words pCapN and pCapCN. capC
-- is a class code, not a parameter. Q-S5-3 (a): the country set S1 = {840}
-- gives class 1 (cls), and the other countries give class 0. Q-S6-5 (a):
-- the country rule lets a class pass when the state map passCls holds it
-- (init: class 0, an offer to holders outside S1 only). inSet reads the
-- class, not the country, and an address that did not register has class 0.
def capC : U256 := 0u
def inS1 : U256 -> Flag := fun (n : U256) => u256Eq n 840u
def cls : U256 -> U256 := fun (n : U256) => flagIf (inS1 n) 1u 0u
def inSet : State -> U256 -> Flag := fun (s : State) (k : U256) => mapGet (passCls s) k

-- Q-S4-5 (a): the sender and the receiver of a move. A mint has no sender
-- and a burn has no receiver, so each one gives noAddr (lock end 0).
def moveFrom : Move -> Addr :=
  fun (m : Move) =>
    either (fun (p : Prod Addr (Prod Addr U256)) => first p)
      (fun (q : Sum (Prod Addr U256) (Prod Addr U256)) =>
        either (fun (p : Prod Addr U256) => noAddr) (fun (p : Prod Addr U256) => first p) q)
      m
def moveTo : Move -> Addr :=
  fun (m : Move) =>
    either (fun (p : Prod Addr (Prod Addr U256)) => first (second p))
      (fun (q : Sum (Prod Addr U256) (Prod Addr U256)) =>
        either (fun (p : Prod Addr U256) => first p) (fun (p : Prod Addr U256) => noAddr) q)
      m

-- The rule tests (PLAN section 3.3). A cap decides on the state after the
-- move, so a move to an address that holds tokens passes a full cap.
def holderCap : State -> Env -> Move -> Flag :=
  fun (s : State) (e : Env) (m : Move) => u256Le (holders (step s e m)) (pCapN s)
-- S7: the class count after a transfer, from the count before it.
def classAfterT : State -> Addr -> Addr -> U256 -> U256 :=
  fun (s : State) (f : Addr) (t : Addr) (x : U256) =>
    dropAt (bumpAt (mapGet (holdersIn s) capC) (clsCode s t) capC (both (notF (addrEq f t)) (gains (mapGet (bal s) t) x)))
      (clsCode s f) capC (both (notF (addrEq f t)) (loses (mapGet (bal s) f) x))
def classCap : State -> Env -> Move -> Flag :=
  fun (s : State) (e : Env) (m : Move) =>
    either (fun (p : Prod Addr (Prod Addr U256)) => u256Le (classAfterT s (first p) (first (second p)) (second (second p))) (pCapCN s))
      (fun (q : Sum (Prod Addr U256) (Prod Addr U256)) => u256Le (mapGet (holdersIn (step s e m)) capC) (pCapCN s))
      m
def countryIn : State -> Env -> Move -> Flag :=
  fun (s : State) (e : Env) (m : Move) => inSet s (clsCode s (moveTo m))
def lockUp : State -> Env -> Move -> Flag :=
  fun (s : State) (e : Env) (m : Move) => natLe (mapGet (lockEnd s) (moveFrom m)) (now e)

-- Q-S4-1 (a): the form gives the proposition and the dec term of each rule,
-- their product allowed, allowed.dec, allowed.bit and the view canTransfer.
rules allowed State Move transfer := holderCap | classCap | countryIn | lockUp

-- Q-S4-6 (a): transferred emits Broken when canTransfer is no on the state
-- before the move. The move still runs (Q9 (a)).
event Broken (brokenFrom : Addr) (brokenTo : Addr) (brokenAmount : U256)

-- The hooks (Q-S7-2 (a)): each one calls stepT, stepM or stepB directly, so
-- no Move is at the word level. No hook reverts for a rule (Q9 (a)).
def transferred : (env : Env) -> (s : State) -> (f t : Addr) -> (x : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (f t : Addr) (x : U256) =>
    flagIf (fromToken s env)
      (some (pair (stepT s f t x) (flagIf (canTransfer env s f t x) nil (cons (Broken f t x) nil))))
      none
def created : (env : Env) -> (s : State) -> (t : Addr) -> (x : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (t : Addr) (x : U256) =>
    flagIf (fromToken s env) (some (pair (stepM s env t x) nil)) none
def destroyed : (env : Env) -> (s : State) -> (f : Addr) -> (x : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (f : Addr) (x : U256) =>
    flagIf (fromToken s env) (some (pair (stepB s f x) nil)) none

-- The binding (Q2 (a), Q-S3-2 (a)): a DAO decision. Any caller can apply it,
-- so there is no key.
event TokenBound (boundToken : Addr)
event TokenUnbound (unboundToken : Addr)

def setBound : State -> Addr -> State :=
  fun (s : State) (t : Addr) =>
    makeState (bal s) (holders s) (holdersIn s) (lockEnd s) t (decided s)
      (used s) (clsOf s) (expires s) (ringX s) (ringY s)
      (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s) (dao s)

def bindToken : (env : Env) -> (s : State) -> (t : Addr) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (t : Addr) =>
    flagIf (both (addrEq (bound s) noAddr) (both (notF (addrEq t noAddr)) (addrEq t (decided s))))
      (some (pair (setBound s t) (cons (TokenBound t) nil)))
      none
def unbindToken : (env : Env) -> (s : State) -> (t : Addr) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (t : Addr) =>
    flagIf (both (notF (addrEq t noAddr)) (both (addrEq t (bound s)) (notF (addrEq t (decided s)))))
      (some (pair (setBound s noAddr) (cons (TokenUnbound t) nil)))
      none

-- The setters (Q-S6-8 (a), Q-S7-15 (a)): each DAO decision sets one Part G
-- word, or the token that the DAO decided to bind. Only the dao address of
-- the state can call a setter; another caller reverts. The two Nat words (the
-- lock and the registration lengths) come as U256 words through toNat, so a
-- word above 2^64 - 1 reverts (Q-S7-4).
def withGov : State -> Addr -> U256 -> U256 -> Nat -> Nat -> Map Addr Flag -> Map U256 Flag -> State :=
  fun (s : State) (d : Addr) (a : U256) (b : U256) (l : Nat) (r : Nat) (iss : Map Addr Flag) (pc : Map U256 Flag) =>
    makeState (bal s) (holders s) (holdersIn s) (lockEnd s) (bound s) d
      (used s) (clsOf s) (expires s) (ringX s) (ringY s) a b l r iss pc (dao s)
def fromDao : State -> Env -> Flag := fun (s : State) (e : Env) => addrEq (caller e) (dao s)
def setCapN : (env : Env) -> (s : State) -> (v : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (v : U256) =>
    flagIf (fromDao s env)
      (some (pair (withGov s (decided s) v (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s)) nil)) none
def setCapCN : (env : Env) -> (s : State) -> (v : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (v : U256) =>
    flagIf (fromDao s env)
      (some (pair (withGov s (decided s) (pCapN s) v (pLockD s) (pRegD s) (issuers s) (passCls s)) nil)) none
def setLockD : (env : Env) -> (s : State) -> (v : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (v : U256) =>
    flagIf (fromDao s env)
      (some (pair (withGov s (decided s) (pCapN s) (pCapCN s) (toNat v) (pRegD s) (issuers s) (passCls s)) nil)) none
def setRegD : (env : Env) -> (s : State) -> (v : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (v : U256) =>
    flagIf (fromDao s env)
      (some (pair (withGov s (decided s) (pCapN s) (pCapCN s) (pLockD s) (toNat v) (issuers s) (passCls s)) nil)) none
def setIssuer : (env : Env) -> (s : State) -> (a : Addr) -> (f : Flag) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (a : Addr) (f : Flag) =>
    flagIf (fromDao s env)
      (some (pair (withGov s (decided s) (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (mapSet (issuers s) a f) (passCls s)) nil))
      none
def setPass : (env : Env) -> (s : State) -> (k : U256) -> (f : Flag) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (k : U256) (f : Flag) =>
    flagIf (fromDao s env)
      (some (pair (withGov s (decided s) (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (mapSet (passCls s) k f)) nil))
      none
def setDecided : (env : Env) -> (s : State) -> (t : Addr) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (t : Addr) =>
    flagIf (fromDao s env)
      (some (pair (withGov s t (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s)) nil)) none

-- Views.
def isTokenBound : (env : Env) -> (s : State) -> (t : Addr) -> Flag :=
  fun (env : Env) (s : State) (t : Addr) => both (notF (addrEq t noAddr)) (addrEq t (bound s))
def getTokenBound : (env : Env) -> (s : State) -> Addr := fun (env : Env) (s : State) => bound s
def balanceOf : (env : Env) -> (s : State) -> (a : Addr) -> U256 :=
  fun (env : Env) (s : State) (a : Addr) => mapGet (bal s) a
def holderCount : (env : Env) -> (s : State) -> U256 := fun (env : Env) (s : State) => holders s
def lockOf : (env : Env) -> (s : State) -> (a : Addr) -> Nat :=
  fun (env : Env) (s : State) (a : Addr) => mapGet (lockEnd s) a

-- Part C (docs/PLAN.md sections 3.4 and 14). Q-S7-6 (a): the contract word
-- selfWord is the Env word self of the call. Q-S6-4 (a): an issuer is an
-- address that the state map issuers holds. Q-S6-2 (a): the length of a
-- registration in seconds is the state word pRegD. selfAddr is the receiver
-- address of test/evmchain.sh (examples/selfenv.lang), so wC is the contract
-- word of the rows and of the chain.
def selfAddr : Addr := 0x0000000000000000000000007265636569766572
def selfWord : Env -> U256 := fun (e : Env) => addrToU256 (self e)
def wC : U256 := addrToU256 selfAddr

-- Q-S5-4 (a): two key slots for each class. Slot i of class c has the key
-- c + c + i (the kit has no u256Mul).
def slot : U256 -> U256 -> U256 := fun (c : U256) (i : U256) => u256Add (u256Add c c) i
def ringKey : State -> U256 -> U256 -> Prod U256 U256 :=
  fun (s : State) (c : U256) (i : U256) => pair (mapGet (ringX s) (slot c i)) (mapGet (ringY s) (slot c i))
def ring : State -> U256 -> List (Prod U256 U256) :=
  fun (s : State) (c : U256) => cons (ringKey s c 0u) (cons (ringKey s c 1u) nil)

-- The events of Part C. Registered shows the class and the key image only.
event Issued (issuedClass : U256) (issuedSlot : U256)
event Registered (regClass : U256) (regX : U256) (regY : U256)

def setKey : State -> U256 -> U256 -> U256 -> State :=
  fun (s : State) (k : U256) (kx : U256) (ky : U256) =>
    makeState (bal s) (holders s) (holdersIn s) (lockEnd s) (bound s) (decided s)
      (used s) (clsOf s) (expires s) (mapSet (ringX s) k kx) (mapSet (ringY s) k ky)
      (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s) (dao s)

-- Q-S7-13 (a): hpAt k w c is yes when the x word of H_p (k, w) is the hash
-- of the counter c. hpOk k w is yes when a counter below K = 8 gives it (the
-- bound RESTRICT_HP_TRIES). On the chain, the H_p loop traps when no counter
-- below K gives a point (Q-S7-14 (e1)), and eval gives no: issue fails on both.
def hpAt : Prod U256 U256 -> U256 -> U256 -> Flag :=
  fun (k : Prod U256 U256) (w : U256) (c : U256) =>
    u256Eq (first (zkHpAt k w)) (hash (hash (hash (first k) (second k)) w) c)
def hpHasCounter : U256 -> U256 -> Flag :=
  fun (hx seed : U256) =>
    flagIf (u256Eq hx (hash seed 0u)) flagYes (flagIf (u256Eq hx (hash seed 1u)) flagYes
      (flagIf (u256Eq hx (hash seed 2u)) flagYes (flagIf (u256Eq hx (hash seed 3u)) flagYes
        (flagIf (u256Eq hx (hash seed 4u)) flagYes (flagIf (u256Eq hx (hash seed 5u)) flagYes
          (flagIf (u256Eq hx (hash seed 6u)) flagYes (u256Eq hx (hash seed 7u))))))))
def hpOk : Prod U256 U256 -> U256 -> Flag :=
  fun (k : Prod U256 U256) (w : U256) =>
    hpHasCounter (first (zkHpAt k w)) (hash (hash (first k) (second k)) w)

-- Issued keys pass hpAt, but an empty slot also participates in the ring.
-- Its counter depends on selfWord, so check it before accepting a partial ring.
def emptyKey : Prod U256 U256 -> Flag :=
  fun (k : Prod U256 U256) => both (u256Eq (first k) 0u) (u256Eq (second k) 0u)
def ringBound : State -> Env -> U256 -> Flag :=
  fun (s : State) (e : Env) (c : U256) =>
    flagIf (both (notF (emptyKey (ringKey s c 0u))) (notF (emptyKey (ringKey s c 1u))))
      flagYes (hpOk (pair 0u 0u) (selfWord e))

-- issue c i kx ky hc: an issuer writes the key (kx, ky) into slot i of class
-- c. A slot i > 1 is slot i - 2 of class c + 1, so issue reverts for it.
-- Q-S7-5 (a): issue reverts for a key with no H_p point below K at the
-- contract word. Q-S7-14 (e1): hc is the H_p counter of the key (hpIdx), and
-- issue reverts when hc > 7 or when hc does not give the point.
def issue : (env : Env) -> (s : State) -> (c i kx ky hc : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (c i kx ky hc : U256) =>
    flagIf (both (mapGet (issuers s) (caller env)) (both (u256Le i 1u) (both (u256Le hc 7u) (hpAt (pair kx ky) (selfWord env) hc))))
      (some (pair (setKey s (slot c i) kx ky) (cons (Issued c i) nil)))
      none

-- Q-S5-5 (a), Q-S5-6 (a): the checks of register. The signature verifies over
-- the ring of class c at the contract word, with the caller as the message.
-- The key image (ix, iy) is not used (L7). A caller that holds tokens keeps
-- its class, so holdersIn stays exact.
def regOk : State -> Env -> U256 -> List U256 -> U256 -> U256 -> Flag :=
  fun (s : State) (e : Env) (c : U256) (sig : List U256) (ix : U256) (iy : U256) =>
    both (ringBound s e c)
      (both (zkVerifyAt (ring s c) (selfWord e) (addrToU256 (caller e)) sig)
        (both (notF (mapGet (used s) (hash ix iy)))
          (flagIf (u256Eq (mapGet (bal s) (caller e)) 0u) flagYes (u256Eq (clsCode s (caller e)) c))))
def regSet : State -> Env -> U256 -> U256 -> U256 -> State :=
  fun (s : State) (e : Env) (c : U256) (ix : U256) (iy : U256) =>
    makeState (bal s) (holders s) (holdersIn s) (lockEnd s) (bound s) (decided s)
      (mapSet (used s) (hash ix iy) flagYes) (mapSet (clsOf s) (caller e) c)
      (mapSet (expires s) (caller e) (natAdd (now e) (pRegD s))) (ringX s) (ringY s)
      (pCapN s) (pCapCN s) (pLockD s) (pRegD s) (issuers s) (passCls s) (dao s)

-- register c c1 s1 s2 ix iy: the five words of a signature for n = 2.
def register : (env : Env) -> (s : State) -> (c c1 s1 s2 ix iy : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (c c1 s1 s2 ix iy : U256) =>
    flagIf (regOk s env c (cons c1 (cons s1 (cons s2 (cons ix (cons iy nil))))) ix iy)
      (some (pair (regSet s env c ix iy) (cons (Registered c ix iy) nil)))
      none

-- L8 (Q-S5-6 (a)): a registration is live before its end. An address that
-- did not register has the end 0.
def isVerified : (env : Env) -> (s : State) -> (w : Addr) -> Flag :=
  fun (env : Env) (s : State) (w : Addr) => notF (natLe (mapGet (expires s) w) (now env))

