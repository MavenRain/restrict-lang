-- At self 0x100 the generator has counter 7, but the empty slot needs 23.
-- A partial ring must fail on both eval and chain; filling it restores service.
def partialSelf : Addr := 0x0000000000000000000000000000000000000100
def partialEnv : Env := makeEnv 100 100u dave partialSelf
def partialState : State := setKey init (slot 0u 0u) 1u 2u
def partialSig : List U256 := zkSignAt (ring partialState 0u) 1u 256u (addrToU256 dave)
def partialImg : Prod U256 U256 := ecMul (zkHpAt gen 256u) 1u
def partialSigned : Path Flag (zkVerifyAt (ring partialState 0u) 256u (addrToU256 dave) partialSig) flagYes := refl
