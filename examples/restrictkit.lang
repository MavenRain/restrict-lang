-- Part C laws by refl (docs/PLAN.md section 8). The test keys zkKey 13, 2 and
-- 18 have an H_p point below K at wC (zkKey 0 and 1 of restrict.lang do not
-- all have one). The issuer issuer0 puts k0 and k1 into the ring of class 1
-- and k2 into slot 0 of class 0. dave and erin hold no tokens. alice holds
-- 5u in class 0.
def gen : Prod U256 U256 := pair 1u 2u
def k0 : Prod U256 U256 := ecMul gen (zkKey 13)
def k1 : Prod U256 U256 := ecMul gen (zkKey 2)
def k2 : Prod U256 U256 := ecMul gen (zkKey 18)
def kR : Prod U256 U256 := ecMul gen (zkKey 1)
def erin : Addr := 0x0000000000000000000000000000000000000099
def eI : Env := makeEnv 100 100u issuer0 selfAddr
def eD : Env := makeEnv 100 100u dave selfAddr
def eE : Env := makeEnv 100 100u erin selfAddr
def eA : Env := makeEnv 100 100u alice selfAddr
def r1 : State := setKey (setKey (setKey s2 (slot 1u 0u) (first k0) (second k0)) (slot 1u 1u) (first k1) (second k1)) (slot 0u 0u) (first k2) (second k2)

-- issue: the issuer only, slots 0 and 1 only, and the H_p counter of the key
-- only (k0 0u, k1 5u, k2 7u; kR has no counter below K).
def issueSets : Path (Option (Prod State (List Out))) (issue eI s2 1u 0u (first k0) (second k0) 0u)
  (some (pair (setKey s2 (slot 1u 0u) (first k0) (second k0)) (cons (Issued 1u 0u) nil))) := refl
def issueMaxCounter : Path (Option (Prod State (List Out))) (issue eI s2 0u 0u (first k2) (second k2) 7u)
  (some (pair (setKey s2 (slot 0u 0u) (first k2) (second k2)) (cons (Issued 0u 0u) nil))) := refl
def issueNotIssuer : Path (Option (Prod State (List Out))) (issue eD s2 1u 0u (first k0) (second k0) 0u) none := refl
def issueNoSlot2 : Path (Option (Prod State (List Out))) (issue eI s2 1u 2u (first k0) (second k0) 0u) none := refl
def ringSlot : Path (Prod U256 U256) (ringKey r1 1u 1u) k1 := refl
def issueNoPoint : Path (Option (Prod State (List Out))) (issue eI s2 1u 0u (first kR) (second kR) 7u) none := refl
def issueBadCounter : Path (Option (Prod State (List Out))) (issue eI s2 1u 1u (first k1) (second k1) 0u) none := refl

-- The H_p counter of a key at wC: the first counter below K that gives the
-- point, or K = 8 when there is none.
def hpIdx : Prod U256 U256 -> U256 -> U256 :=
  fun (k : Prod U256 U256) (w : U256) =>
    flagIf (hpAt k w 0u) 0u (flagIf (hpAt k w 1u) 1u (flagIf (hpAt k w 2u) 2u (flagIf (hpAt k w 3u) 3u
      (flagIf (hpAt k w 4u) 4u (flagIf (hpAt k w 5u) 5u (flagIf (hpAt k w 6u) 6u (flagIf (hpAt k w 7u) 7u 8u)))))))
def hpC0 : U256 := hpIdx k0 wC
def hpC1 : U256 := hpIdx k1 wC
def hpC2 : U256 := hpIdx k2 wC
def hpCZ : U256 := hpIdx (pair 0u 0u) wC
def hpCR : U256 := hpIdx kR wC
def hpOkR : Flag := hpOk kR wC
def hpC0Is : Path U256 hpC0 0u := refl
def hpC1Is : Path U256 hpC1 5u := refl
def hpC2Is : Path U256 hpC2 7u := refl
def hpCZIs : Path U256 hpCZ 7u := refl
def hpCRIs : Path U256 hpCR 8u := refl
def hpOkRNo : Path Flag hpOkR flagNo := refl
-- Q-S7-14 (e1): the counter of a key gives its point and no lower counter
-- does, so hpOk is yes for the keys with a counter below K.
def hpAtC0 : Path Flag (hpAt k0 wC hpC0) flagYes := refl
def hpAtC1 : Path Flag (hpAt k1 wC hpC1) flagYes := refl
def hpAtC1Below : Path Flag (hpAt k1 wC 4u) flagNo := refl
def hpAtC2 : Path Flag (hpAt k2 wC hpC2) flagYes := refl
def hpOkK0 : Path Flag (hpOk k0 wC) flagYes := refl
def hpOkK2 : Path Flag (hpOk k2 wC) flagYes := refl

-- The key image of zkKey j at the word w.
def imgAt : Nat -> U256 -> Prod U256 U256 :=
  fun (j : Nat) (w : U256) => ecMul (zkHpAt (ecMul gen (zkKey j)) w) (zkKey j)
def img0 : Prod U256 U256 := imgAt 13 wC
def img1 : Prod U256 U256 := imgAt 2 wC
def img2 : Prod U256 U256 := imgAt 18 wC
def sigD : List U256 := zkSignAt (ring r1 1u) (zkKey 13) wC (addrToU256 dave)
def sigE : List U256 := zkSignAt (ring r1 1u) (zkKey 13) wC (addrToU256 erin)
def r2 : State := regSet r1 eD 1u (first img0) (second img0)

-- register: the signature of dave verifies at the contract word, for dave and
-- class 1 only.
def regDave : Path Flag (regOk r1 eD 1u sigD (first img0) (second img0)) flagYes := refl
def regOtherCaller : Path Flag (regOk r1 eE 1u sigD (first img0) (second img0)) flagNo := refl
def regOtherClass : Path Flag (regOk r1 eD 0u sigD (first img0) (second img0)) flagNo := refl
def regOtherWord : Path Flag (zkVerifyAt (ring r1 1u) (addrToU256 testToken) (addrToU256 dave) sigD) flagNo := refl
def regClass : Path U256 (clsCode r2 dave) 1u := refl

-- L7: after dave registers, the key image of zkKey 0 is used. The signature of
-- erin with the same key verifies, but erin cannot register. At another
-- contract word the key image is another point (O8).
def l7Verifies : Path Flag (zkVerifyAt (ring r2 1u) wC (addrToU256 erin) sigE) flagYes := refl
def l7Used : Path Flag (regOk r2 eE 1u sigE (first img0) (second img0)) flagNo := refl
def l7Context : Path Flag (u256Eq (first img0) (first (imgAt 13 (addrToU256 testToken)))) flagNo := refl

-- Q-S5-6 (a): alice holds tokens in class 0, so a register into class 1
-- reverts and a register into class 0 is valid. A renewal in the same class
-- with a new key is valid (O10).
def sigA1 : List U256 := zkSignAt (ring r1 1u) (zkKey 2) wC (addrToU256 alice)
def sigA0 : List U256 := zkSignAt (ring r1 0u) (zkKey 18) wC (addrToU256 alice)
def sigR : List U256 := zkSignAt (ring r2 1u) (zkKey 2) wC (addrToU256 dave)
def holderMoves : Path Flag (regOk r1 eA 1u sigA1 (first img1) (second img1)) flagNo := refl
