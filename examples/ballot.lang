-- The Part D ballots on the chain (intent-lang S9, Q-S9-6 .. Q-S9-9 (a);
-- restrict-lang S6, Q-S6-1 and Q-S6-7 (a)). A kit file: word literals and
-- word ops are kit items. Each constant comes from the host
-- (`build/ballottool words`: the election key PK of thresholdtool (n 3, t
-- 2), the ring zkKey 0 .. 2 as points, the proposal pid 1 of the contract
-- self, voters 0, 1 and 2 vote yes, yes and no; k 2, yes is slot 0), and
-- test/precompile.sh deploys this contract after onehot.lang. ballotCtx is
-- the hash chain from ballotTag ("ballot") over the key image I and pid
-- (O34), and slotBound and sumBound check the proofs of onehot.lang under
-- it, so a ballot copied under a second key image or into a second proposal
-- fails them. ballotSig checks the ring signature over ballotDigest, the
-- hash chain from digestTag ("digest") over the 8 slot ciphertext words, so
-- a changed slot fails it. The ring signs in the context word pctx =
-- hash(selfWord, pid) (zkVerifyAt, O15), so a key has one key image for each
-- contract and proposal. PK is a contract constant (O39). tallyX and tallyY
-- add two slot ciphertext points; the opening views are those of
-- threshold.lang on the summed slots. The cast entry, the encrypted tally in
-- state and enact are S7 (Q-S6-8 (a)).
state State := makeState (cast : Nat)

def init : State := makeState 0

def ballotTag : U256 := 0x62616c6c6f74u

def digestTag : U256 := 0x646967657374u

def randTag : U256 := 0x72616e64u

def onehotTag : U256 := 0x6f6e65686f74u

def dleqTag : U256 := 1684825457u

def pid : U256 := 1u

-- The contract word, as in restrict.lang (a constant until the writer of S7).
def selfAddr : Addr := 0x00000000000000000000000000000000000000c0

def selfWord : U256 := addrToU256 selfAddr

-- The context word of the ring signature.
def pctx : U256 := hash selfWord pid

