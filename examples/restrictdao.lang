def ring : List (Prod U256 U256) := cons (pair p0x p0y) (cons (pair p1x p1y) (cons (pair p2x p2y) nil))

def gen : Prod U256 U256 := pair 1u 2u

-- -G = (r - 1) G = (1, p - 2).
def negG : Prod U256 U256 := pair 1u 0x30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd45u

def maxWord : U256 := 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu
-- The R2 attack words of `build/ballottool rdao16`: a sum proof for the slots
-- of the pid 1 ballot b0 under the ctx of its key image at pid 16.
def atksumax : U256 := 0x160562736c42b38b893db4411afce90bbe010b0d7e963c8d74e3b418d2b4a943u
def atksumay : U256 := 0x10c346f165e377a1c208d094e942112a36772e6379306e6b837eacd7f683701eu
def atksumbx : U256 := 0x203fa119967e0113f82b181f4b3af1c674405fb3828e2864c8a4f1b45040f71bu
def atksumby : U256 := 0x2a2c6f0214cddb6c527194e0be8218c18d8584b15c5e6f6d94db3461cf51d044u
def atksumz : U256 := 0x075127f332b4940b029e66c3df3919f930e29dc88674d5b729bd719ca7657ce5u

def pointEq : (p q : Prod U256 U256) -> Flag :=
  fun (p q : Prod U256 U256) => flagIf (u256Eq (first p) (first q)) (u256Eq (second p) (second q)) flagNo

-- z P = A + e Q: 2 ecMul, 1 ecAdd.
def holds : (p a q : Prod U256 U256) -> (z e : U256) -> Flag :=
  fun (p a q : Prod U256 U256) (z e : U256) => pointEq (ecMul p z) (ecAdd a (ecMul q e))

def randChallenge : (ctx pkx pky c1x c1y c2x c2y m ax ay bx by : U256) -> U256 :=
  fun (ctx pkx pky c1x c1y c2x c2y m ax ay bx by : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash randTag ctx) pkx) pky) c1x) c1y) c2x) c2y) m) ax) ay) bx) by

def orChallenge : (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y : U256) -> U256 :=
  fun (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash onehotTag ctx) j) pkx) pky) c1x) c1y) c2x) c2y) a0x) a0y) b0x) b0y) a1x) a1y) b1x) b1y

def randWith : (pkx pky c1x c1y c2x c2y m ax ay bx by z e : U256) -> Flag :=
  fun (pkx pky c1x c1y c2x c2y m ax ay bx by z e : U256) =>
    flagIf (holds gen (pair ax ay) (pair c1x c1y) z e)
      (holds (pair pkx pky) (pair bx by) (ecAdd (pair c2x c2y) (ecMul negG m)) z e)
      flagNo

def rand : (ctx pkx pky c1x c1y c2x c2y m ax ay bx by z : U256) -> Flag :=
  fun (ctx pkx pky c1x c1y c2x c2y m ax ay bx by z : U256) =>
    randWith pkx pky c1x c1y c2x c2y m ax ay bx by z (randChallenge ctx pkx pky c1x c1y c2x c2y m ax ay bx by)

-- e0 + e1 = e modulo 2^256, as the host split. u256Add traps on an overflow
-- and about one honest split in two wraps, so the check uses no add: e1 =
-- e - e0 when e0 <= e, else e1 - 1 = maxWord - (e0 - e) with e1 >= 1. Each
-- u256Sub of a taken branch is exact.
def splitOk : (e e0 e1 : U256) -> Flag :=
  fun (e e0 e1 : U256) =>
    flagIf (u256Le e0 e) (u256Eq (u256Sub e e0) e1)
      (flagIf (u256Le 1u e1) (u256Eq (u256Sub e1 1u) (u256Sub maxWord (u256Sub e0 e))) flagNo)

def slotWith : (pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 e : U256) -> Flag :=
  fun (pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 e : U256) =>
    flagIf (splitOk e e0 e1)
      (flagIf (holds gen (pair a0x a0y) (pair c1x c1y) z0 e0)
        (flagIf (holds (pair pkx pky) (pair b0x b0y) (pair c2x c2y) z0 e0)
          (flagIf (holds gen (pair a1x a1y) (pair c1x c1y) z1 e1)
            (holds (pair pkx pky) (pair b1x b1y) (ecAdd (pair c2x c2y) negG) z1 e1)
            flagNo)
          flagNo)
        flagNo)
      flagNo

def slot : (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) -> Flag :=
  fun (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) =>
    slotWith pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1
      (orChallenge ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y)
def challenge : (pkx pky cx cy dx dy ax ay bx by : U256) -> U256 :=
  fun (pkx pky cx cy dx dy ax ay bx by : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash dleqTag pkx) pky) cx) cy) dx) dy) ax) ay) bx) by


def dleqWith : (pkx pky cx cy dx dy ax ay bx by z e : U256) -> Flag :=
  fun (pkx pky cx cy dx dy ax ay bx by z e : U256) =>
    flagIf (pointEq (ecMul (pair 1u 2u) z) (ecAdd (pair ax ay) (ecMul (pair pkx pky) e)))
      (pointEq (ecMul (pair cx cy) z) (ecAdd (pair bx by) (ecMul (pair dx dy) e)))
      flagNo

def dleq : (pkx pky cx cy dx dy ax ay bx by z : U256) -> Flag :=
  fun (pkx pky cx cy dx dy ax ay bx by z : U256) =>
    dleqWith pkx pky cx cy dx dy ax ay bx by z (challenge pkx pky cx cy dx dy ax ay bx by)

def opens : (ux uy vx vy n : U256) -> Flag :=
  fun (ux uy vx vy n : U256) => pointEq (pair ux uy) (ecAdd (ecMul (pair 1u 2u) n) (pair vx vy))

def ctxOf : (p ix iy : U256) -> U256 :=
  fun (p ix iy : U256) => hash (hash (hash ballotTag ix) iy) p

def sumWith : (ctx : U256) -> (c1 c2 : Prod U256 U256) -> (ax ay bx by z : U256) -> Flag :=
  fun (ctx : U256) (c1 c2 : Prod U256 U256) (ax ay bx by z : U256) =>
    rand ctx pkx pky (first c1) (second c1) (first c2) (second c2) 1u ax ay bx by z

def digestOf : (u1x u1y u2x u2y v1x v1y v2x v2y : U256) -> U256 :=
  fun (u1x u1y u2x u2y v1x v1y v2x v2y : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash digestTag u1x) u1y) u2x) u2y) v1x) v1y) v2x) v2y

-- sigOk gets the word w = hash (selfWord, pid) from castSig, not the State: a State argument to this def costs
-- about 6.3 KB of runtime (Q-S7-28 (a), S7 s7 size report).
def sigOk : (env : Env) -> (w : U256) -> (u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 ix iy : U256) -> Flag :=
  fun (env : Env) (w : U256) (u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 ix iy : U256) =>
    zkVerifyAt ring w (digestOf u1x u1y u2x u2y v1x v1y v2x v2y) (cons c1 (cons s1 (cons s2 (cons s3 (cons ix (cons iy nil))))))

-- The ctx of a key image: 3 hash.

def sum3 : (p q r : Prod U256 U256) -> Prod U256 U256 :=
  fun (p q r : Prod U256 U256) => ecAdd (ecAdd p q) r

def openSum : (c1 c2 : Prod U256 U256) -> (cx cy ex ey d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) -> Flag :=
  fun (c1 c2 : Prod U256 U256) (cx cy ex ey d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) =>
    flagIf (pointEq c1 (pair cx cy))
      (flagIf (pointEq c2 (pair ex ey))
        (flagIf (dleq k1x k1y cx cy d1x d1y a1x a1y b1x b1y z1)
          (flagIf (dleq k2x k2y cx cy d2x d2y a2x a2y b2x b2y z2)
            (pointEq (pair ex ey) (ecAdd (ecMul gen m) (ecAdd (ecMul (pair d1x d1y) l1) (ecMul (pair d2x d2y) l2))))
            flagNo)
          flagNo)
        flagNo)
      flagNo


-- The nullifier of a key image and the first pend index of slot j (4 j).
def nullOf : (p ix iy : U256) -> U256 :=
  fun (p ix iy : U256) => hash (hash ix iy) p
def slotBase : (j : U256) -> U256 :=
  fun (j : U256) => u256Add (u256Add j j) (u256Add j j)
-- The kept point at pend index k and k + 1 of N.
def kept : (p : Map U256 U256) -> (n k : U256) -> Prod U256 U256 :=
  fun (p : Map U256 U256) (n k : U256) => pair (mapGet p (hash n k)) (mapGet p (hash n (u256Add k 1u)))

-- Entry castSig (14 words): N not used, the ring signature, then the 8 words to pend and the stage of N reset.
def castSig : (env : Env) -> (s : State) -> (ix iy u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (ix iy u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 : U256) =>
    flagIf (mapGet (used s) (nullOf (pid s) ix iy))
      none
      (flagIf (sigOk env (hash (selfWord env) (pid s)) u1x u1y u2x u2y v1x v1y v2x v2y c1 s1 s2 s3 ix iy)
        (some (pair (makeState (used s)
          (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (pend s)
            (hash (nullOf (pid s) ix iy) 0u) u1x) (hash (nullOf (pid s) ix iy) 1u) u1y) (hash (nullOf (pid s) ix iy) 2u) u2x) (hash (nullOf (pid s) ix iy) 3u) u2y)
            (hash (nullOf (pid s) ix iy) 4u) v1x) (hash (nullOf (pid s) ix iy) 5u) v1y) (hash (nullOf (pid s) ix iy) 6u) v2x) (hash (nullOf (pid s) ix iy) 7u) v2y)
          (mapSet (mapSet (mapSet (stage s) (nullOf (pid s) ix iy) 1u) (hash (nullOf (pid s) ix iy) 0u) 0u) (hash (nullOf (pid s) ix iy) 1u) 0u)
          (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
          (casts s) (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) (pid s) (kind s)) nil))
        none)

-- Entry castSlot (15 words): N has a castSig, j is 0 or 1, the OR proof of slot j on the kept words, then the flag of slot j.
def castSlot : (env : Env) -> (s : State) -> (ix iy j a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (ix iy j a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) =>
    flagIf (u256Eq (mapGet (stage s) (nullOf (pid s) ix iy)) 1u)
      (flagIf (u256Le j 1u)
        (flagIf (slot (ctxOf (pid s) ix iy) j pkx pky
              (first (kept (pend s) (nullOf (pid s) ix iy) (slotBase j))) (second (kept (pend s) (nullOf (pid s) ix iy) (slotBase j)))
              (first (kept (pend s) (nullOf (pid s) ix iy) (u256Add (slotBase j) 2u))) (second (kept (pend s) (nullOf (pid s) ix iy) (u256Add (slotBase j) 2u)))
              a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1)
          (some (pair (makeState (used s) (pend s) (mapSet (stage s) (hash (nullOf (pid s) ix iy) j) 1u)
            (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
            (casts s) (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) (pid s) (kind s)) nil))
          none)
        none)
      none

-- The state after a seal: N used, the slot points added to T0 and T1 (a0 b0 slot 0 c1 c2, a1 b1 slot 1), casts + 1.
def afterSeal : (s : State) -> (n : U256) -> (a0 b0 a1 b1 : Prod U256 U256) -> State :=
  fun (s : State) (n : U256) (a0 b0 a1 b1 : Prod U256 U256) =>
    makeState (mapSet (used s) n flagYes) (pend s) (stage s)
      (first a0) (second a0) (first b0) (second b0) (first a1) (second a1) (first b1) (second b1)
      (u256Add (casts s) 1u) (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) (pid s) (kind s)

-- Entry castSeal (7 words): N not used, both slot flags, block <= castEnd, the sum proof on the kept slots, then the tally add.
def castSeal : (env : Env) -> (s : State) -> (ix iy ax ay bx by z : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (ix iy ax ay bx by z : U256) =>
    flagIf (mapGet (used s) (nullOf (pid s) ix iy))
      none
      (flagIf (u256Eq (mapGet (stage s) (nullOf (pid s) ix iy)) 1u)
        (flagIf (u256Eq (mapGet (stage s) (hash (nullOf (pid s) ix iy) 0u)) 1u)
          (flagIf (u256Eq (mapGet (stage s) (hash (nullOf (pid s) ix iy) 1u)) 1u)
            (flagIf (u256Le (block env) (castEnd s))
              (flagIf (sumWith (ctxOf (pid s) ix iy) (ecAdd (kept (pend s) (nullOf (pid s) ix iy) 0u) (kept (pend s) (nullOf (pid s) ix iy) 4u))
                    (ecAdd (kept (pend s) (nullOf (pid s) ix iy) 2u) (kept (pend s) (nullOf (pid s) ix iy) 6u)) ax ay bx by z)
                (some (pair (afterSeal s (nullOf (pid s) ix iy)
                  (ecAdd (pair (t0ax s) (t0ay s)) (kept (pend s) (nullOf (pid s) ix iy) 0u))
                  (ecAdd (pair (t0bx s) (t0by s)) (kept (pend s) (nullOf (pid s) ix iy) 2u))
                  (ecAdd (pair (t1ax s) (t1ay s)) (kept (pend s) (nullOf (pid s) ix iy) 4u))
                  (ecAdd (pair (t1bx s) (t1by s)) (kept (pend s) (nullOf (pid s) ix iy) 6u))) nil))
                none)
              none)
            none)
          none)
        none)

-- hpAt k w c (copy of examples/restrictkit.lang, Q-S7-13 (a)): yes when the x word of H_p (k, w) is the hash of
-- the counter c. both a b: a and b.
def hpAt : Prod U256 U256 -> U256 -> U256 -> Flag :=
  fun (k : Prod U256 U256) (w : U256) (c : U256) =>
    u256Eq (first (zkHpAt k w)) (hash (hash (hash (first k) (second k)) w) c)
def both : Flag -> Flag -> Flag := fun (a : Flag) (b : Flag) => flagIf a b flagNo

-- Duration setters convert to Nat in restrictkit; cap setters keep all U256 values.
def proposalValueOk : U256 -> U256 -> Flag :=
  fun (k v : U256) =>
    flagIf (u256Le k 1u) flagYes (both (u256Le k 3u) (u256Le v 18446744073709551615u))

-- Entry propose (6 words): the caller is the proposer, block > castEnd, p > pid, k <= 3, durations fit Nat, and for each ring point i
-- the H_p counter hc_i <= 7 gives the point at the word hash (selfWord, p) (the bound before each hpAt, as the
-- restrictkit issue). Then pid p, kind k, proposal v, castEnd block + period, T0 and T1 (0, 0), casts 0, enacted no.
def propose : (env : Env) -> (s : State) -> (p hc0 hc1 hc2 k v : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (p hc0 hc1 hc2 k v : U256) =>
    flagIf (addrEq (caller env) proposer)
      (flagIf (u256Le (block env) (castEnd s))
        none
        (flagIf (u256Le p (pid s))
          none
          (flagIf (both (proposalValueOk k v) (both (u256Le hc0 7u) (both (hpAt (pair p0x p0y) (hash (selfWord env) p) hc0)
                (both (u256Le hc1 7u) (both (hpAt (pair p1x p1y) (hash (selfWord env) p) hc1)
                  (both (u256Le hc2 7u) (hpAt (pair p2x p2y) (hash (selfWord env) p) hc2)))))))
            (some (pair (makeState (used s) (pend s) (stage s) 0u 0u 0u 0u 0u 0u 0u 0u 0u
              (u256Add (block env) period) v (window s) flagNo (keys s) (fills s) p k) nil))
            none)))
      none

-- Entry enact (15 words): block > castEnd, not enacted, m <= casts, the opening of T0 (two DLEQ shares of {1, 2}),
-- then the window moves to the proposal when yes = m > no = casts - m, and enacted is set.
def enact : (env : Env) -> (s : State) -> (d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) =>
    flagIf (u256Le (block env) (castEnd s))
      none
      (flagIf (enacted s)
        none
        (flagIf (u256Le m (casts s))
          (flagIf (openSum (pair (t0ax s) (t0ay s)) (pair (t0bx s) (t0by s)) (t0ax s) (t0ay s) (t0bx s) (t0by s)
                d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m)
            (some (pair (makeState (used s) (pend s) (stage s)
              (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
              (casts s) (castEnd s) (proposal s)
              (flagIf (u256Le m (u256Sub (casts s) m)) (window s) (proposal s))
              flagYes (keys s) (fills s) (pid s) (kind s))
              (flagIf (u256Le m (u256Sub (casts s) m)) nil (flagIf (u256Eq (kind s) 0u) (cons (setCapN kitAddr (proposal s)) nil)
                (flagIf (u256Eq (kind s) 1u) (cons (setCapCN kitAddr (proposal s)) nil)
                (flagIf (u256Eq (kind s) 2u) (cons (setLockD kitAddr (proposal s)) nil)
                (cons (setRegD kitAddr (proposal s)) nil)))))))
            none)
          none))

-- Views: the tally word k (T0 c1x c1y c2x c2y, then T1), the window, the casts, the stage of N (1 castSig, + 2 slot 0, + 4 slot 1).
def tallyWord : (env : Env) -> (s : State) -> (k : U256) -> U256 :=
  fun (env : Env) (s : State) (k : U256) =>
    flagIf (u256Eq k 0u) (t0ax s) (flagIf (u256Eq k 1u) (t0ay s) (flagIf (u256Eq k 2u) (t0bx s) (flagIf (u256Eq k 3u) (t0by s)
      (flagIf (u256Eq k 4u) (t1ax s) (flagIf (u256Eq k 5u) (t1ay s) (flagIf (u256Eq k 6u) (t1bx s) (t1by s)))))))
def windowNow : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => window s
def castCount : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => casts s
def pidNow : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => pid s
def kindNow : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => kind s
def stageOf : (env : Env) -> (s : State) -> (ix iy : U256) -> U256 :=
  fun (env : Env) (s : State) (ix iy : U256) =>
    u256Add (mapGet (stage s) (nullOf (pid s) ix iy))
      (u256Add (u256Add (mapGet (stage s) (hash (nullOf (pid s) ix iy) 0u)) (mapGet (stage s) (hash (nullOf (pid s) ix iy) 0u)))
        (u256Add (u256Add (mapGet (stage s) (hash (nullOf (pid s) ix iy) 1u)) (mapGet (stage s) (hash (nullOf (pid s) ix iy) 1u)))
          (u256Add (mapGet (stage s) (hash (nullOf (pid s) ix iy) 1u)) (mapGet (stage s) (hash (nullOf (pid s) ix iy) 1u)))))

-- Eval rows (test/eval/expect.txt): the 3 casts at BLOCK 0, then enact at BLOCK 11 (> castEnd).
def e0 : Env := makeEnv 0 0u 0xa94f5374fce5edbc8e2a8697c15331677e6ebf0b 0x00000000000000000000000000000000000000da
def e11 : Env := makeEnv 11 11u 0xa94f5374fce5edbc8e2a8697c15331677e6ebf0b 0x00000000000000000000000000000000000000da
def v0sig : Option (Prod State (List Out)) := castSig e0 init b0ix b0iy b0j0c1x b0j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3
def v0slots : Option (Prod State (List Out)) := bind v0sig (fun (r : Prod State (List Out)) =>
  bind (castSlot e0 (first r) b0ix b0iy 0u b0j0a0x b0j0a0y b0j0b0x b0j0b0y b0j0a1x b0j0a1y b0j0b1x b0j0b1y b0j0e0 b0j0e1 b0j0z0 b0j0z1) (fun (q : Prod State (List Out)) =>
    castSlot e0 (first q) b0ix b0iy 1u b0j1a0x b0j1a0y b0j1b0x b0j1b0y b0j1a1x b0j1a1y b0j1b1x b0j1b1y b0j1e0 b0j1e1 b0j1z0 b0j1z1))
def v0 : Option (Prod State (List Out)) := bind v0slots (fun (r : Prod State (List Out)) => castSeal e0 (first r) b0ix b0iy b0sumax b0sumay b0sumbx b0sumby b0sumz)
def v1 : Option (Prod State (List Out)) := bind v0 (fun (r : Prod State (List Out)) =>
  bind (castSig e0 (first r) b1ix b1iy b1j0c1x b1j0c1y b1j0c2x b1j0c2y b1j1c1x b1j1c1y b1j1c2x b1j1c2y b1c1 b1s1 b1s2 b1s3) (fun (a : Prod State (List Out)) =>
    bind (castSlot e0 (first a) b1ix b1iy 0u b1j0a0x b1j0a0y b1j0b0x b1j0b0y b1j0a1x b1j0a1y b1j0b1x b1j0b1y b1j0e0 b1j0e1 b1j0z0 b1j0z1) (fun (b : Prod State (List Out)) =>
      bind (castSlot e0 (first b) b1ix b1iy 1u b1j1a0x b1j1a0y b1j1b0x b1j1b0y b1j1a1x b1j1a1y b1j1b1x b1j1b1y b1j1e0 b1j1e1 b1j1z0 b1j1z1) (fun (c : Prod State (List Out)) =>
        castSeal e0 (first c) b1ix b1iy b1sumax b1sumay b1sumbx b1sumby b1sumz))))
def v2 : Option (Prod State (List Out)) := bind v1 (fun (r : Prod State (List Out)) =>
  bind (castSig e0 (first r) b2ix b2iy b2j0c1x b2j0c1y b2j0c2x b2j0c2y b2j1c1x b2j1c1y b2j1c2x b2j1c2y b2c1 b2s1 b2s2 b2s3) (fun (a : Prod State (List Out)) =>
    bind (castSlot e0 (first a) b2ix b2iy 0u b2j0a0x b2j0a0y b2j0b0x b2j0b0y b2j0a1x b2j0a1y b2j0b1x b2j0b1y b2j0e0 b2j0e1 b2j0z0 b2j0z1) (fun (b : Prod State (List Out)) =>
      bind (castSlot e0 (first b) b2ix b2iy 1u b2j1a0x b2j1a0y b2j1b0x b2j1b0y b2j1a1x b2j1a1y b2j1b1x b2j1b1y b2j1e0 b2j1e1 b2j1z0 b2j1z1) (fun (c : Prod State (List Out)) =>
        castSeal e0 (first c) b2ix b2iy b2sumax b2sumay b2sumbx b2sumby b2sumz))))
def openWith : (m : U256) -> (env : Env) -> (s : State) -> Option (Prod State (List Out)) :=
  fun (m : U256) (env : Env) (s : State) => enact env s tyd1x tyd1y tya1x tya1y tyb1x tyb1y tyz1 tyd2x tyd2y tya2x tya2y tyb2x tyb2y tyz2 m
def stageSig : Option U256 := map (fun (r : Prod State (List Out)) => stageOf e0 (first r) b0ix b0iy) v0sig
def stageSlots : Option U256 := map (fun (r : Prod State (List Out)) => stageOf e0 (first r) b0ix b0iy) v0slots
def tallyHost : Option Flag := map (fun (r : Prod State (List Out)) =>
  flagIf (u256Eq (tallyWord e0 (first r) 0u) tyc1x) (flagIf (u256Eq (tallyWord e0 (first r) 1u) tyc1y)
    (flagIf (u256Eq (tallyWord e0 (first r) 2u) tyc2x) (u256Eq (tallyWord e0 (first r) 3u) tyc2y) flagNo) flagNo) flagNo) v2
def castsAfter : Option U256 := map (fun (r : Prod State (List Out)) => castCount e0 (first r)) v2
def recast : Option (Prod State (List Out)) := bind v0 (fun (r : Prod State (List Out)) => castSig e0 (first r) b0ix b0iy b0j0c1x b0j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3)
def sealEarly : Option (Prod State (List Out)) := bind v0sig (fun (r : Prod State (List Out)) => castSeal e0 (first r) b0ix b0iy b0sumax b0sumay b0sumbx b0sumby b0sumz)
def sealLate : Option (Prod State (List Out)) := bind v0slots (fun (r : Prod State (List Out)) => castSeal e11 (first r) b0ix b0iy b0sumax b0sumay b0sumbx b0sumby b0sumz)
def enactEarly : Option (Prod State (List Out)) := bind v2 (fun (r : Prod State (List Out)) => openWith 2u e0 (first r))
def enactM3 : Option (Prod State (List Out)) := bind v2 (fun (r : Prod State (List Out)) => openWith 3u e11 (first r))
def windowAfter : Option U256 := map (fun (q : Prod State (List Out)) => windowNow e11 (first q)) (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (first r)))
def enactTwice : Option (Prod State (List Out)) := bind (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (first r))) (fun (q : Prod State (List Out)) => openWith 2u e11 (first q))
-- The Out of enact: setCapN kitAddr (proposal) when yes 2 > no 1. On a tie
-- (casts set to 4, so yes 2 = no 2) the Out is nil and the window stays.
def tieState : State -> State := fun (s : State) => makeState (used s) (pend s) (stage s)
  (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
  4u (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) (pid s) (kind s)
def enactOut : Option (List Out) := map (fun (q : Prod State (List Out)) => second q) (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (first r)))
def enactTie : Option (List Out) := map (fun (q : Prod State (List Out)) => second q) (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (tieState (first r))))
def windowTie : Option U256 := map (fun (q : Prod State (List Out)) => windowNow e11 (first q)) (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (tieState (first r))))
-- S7 s7 rows: propose after the s5 enact (done: castEnd 10) at BLOCK 11. Each bad propose gives none: another
-- caller, p = pid (with the pid 1 counters 0 7 3), BLOCK 0 (<= castEnd), k = 4, hc0 + 1 or hc2 + 1 at p = 16, and (R1)
-- p = 2 with the counter 19 of ring point 0 (above the bound 7).
def eOther : Env := makeEnv 11 11u 0x00000000000000000000000000000000000000bb 0x00000000000000000000000000000000000000da
def e22 : Env := makeEnv 22 22u 0xa94f5374fce5edbc8e2a8697c15331677e6ebf0b 0x00000000000000000000000000000000000000da
def done : Option (Prod State (List Out)) := bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (first r))
def proposeOther : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose eOther (first r) 16u 2u 3u 4u 1u 9u)
def proposeSame : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose e11 (first r) 1u 0u 7u 3u 1u 9u)
def proposeEarly : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose e0 (first r) 16u 2u 3u 4u 1u 9u)
def proposeK4 : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose e11 (first r) 16u 2u 3u 4u 4u 9u)
def proposeBadHc : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose e11 (first r) 16u 3u 3u 4u 1u 9u)
def proposeBadHc2 : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose e11 (first r) 16u 2u 3u 5u 1u 9u)
def proposeR1 : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose e11 (first r) 2u 19u 1u 0u 0u 4u)
-- propose at p = 16 (the counters 2, 3, 4) with kind 1 and proposal 9: pid 16, kind 1, casts 0, enacted no. A
-- second propose at p = 16 after the new castEnd (BLOCK 22 > 21) gives none.
def moved : Option (Prod State (List Out)) := bind done (fun (r : Prod State (List Out)) => propose e11 (first r) 16u 2u 3u 4u 1u 9u)
def movedState : Option Flag := map (fun (r : Prod State (List Out)) =>
  flagIf (u256Eq (pidNow e11 (first r)) 16u) (flagIf (u256Eq (kindNow e11 (first r)) 1u)
    (flagIf (u256Eq (castCount e11 (first r)) 0u) (flagIf (enacted (first r)) flagNo flagYes) flagNo) flagNo) flagNo) moved
def proposeTwice : Option (Prod State (List Out)) := bind moved (fun (r : Prod State (List Out)) => propose e22 (first r) 16u 2u 3u 4u 1u 9u)
-- The Out of enact by kind (kindState sets the kind; kind 0 is enactOut): 1 setCapCN, 2 setLockD, 3 setRegD.
def kindState : U256 -> State -> State := fun (k : U256) (s : State) => makeState (used s) (pend s) (stage s)
  (t0ax s) (t0ay s) (t0bx s) (t0by s) (t1ax s) (t1ay s) (t1bx s) (t1by s)
  (casts s) (castEnd s) (proposal s) (window s) (enacted s) (keys s) (fills s) (pid s) k
def enactOut1 : Option (List Out) := map (fun (q : Prod State (List Out)) => second q) (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (kindState 1u (first r))))
def enactOut2 : Option (List Out) := map (fun (q : Prod State (List Out)) => second q) (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (kindState 2u (first r))))
def enactOut3 : Option (List Out) := map (fun (q : Prod State (List Out)) => second q) (bind v2 (fun (r : Prod State (List Out)) => openWith 2u e11 (kindState 3u (first r))))
-- After the move to pid 16 a pid 1 ballot fails sigOk (the word is hash (selfWord, 16)). (R2) The pid 1 image of
-- b0 with castSig and both castSlot but no castSeal does not seal with a fresh sum proof for the pid 16 ctx.
def castOld : Option (Prod State (List Out)) := bind moved (fun (r : Prod State (List Out)) => castSig e11 (first r) b0ix b0iy b0j0c1x b0j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3)
def sealR2 : Option (Prod State (List Out)) := bind (bind v0slots (fun (r : Prod State (List Out)) => propose e11 (first r) 16u 2u 3u 4u 1u 9u)) (fun (q : Prod State (List Out)) => castSeal e11 (first q) b0ix b0iy atksumax atksumay atksumbx atksumby atksumz)

-- Proposals must fit the receiver's duration type; cap proposals retain U256.
def proposeLockOver : Option U256 := map (fun (r : Prod State (List Out)) => proposal (first r)) (propose e11 init 16u 2u 3u 4u 2u 18446744073709551616u)
def proposeRegOver : Option U256 := map (fun (r : Prod State (List Out)) => proposal (first r)) (propose e11 init 16u 2u 3u 4u 3u 18446744073709551616u)
def proposeLockHigh : Option U256 := map (fun (r : Prod State (List Out)) => proposal (first r)) (propose e11 init 16u 2u 3u 4u 2u 0x100000000000000000000000000000000000000000000000000u)
def proposeRegHigh : Option U256 := map (fun (r : Prod State (List Out)) => proposal (first r)) (propose e11 init 16u 2u 3u 4u 3u 0x100000000000000000000000000000000000000000000000000u)
def proposeLockMax : Option Flag := map (fun (r : Prod State (List Out)) => u256Eq (proposal (first r)) 18446744073709551615u) (propose e11 init 16u 2u 3u 4u 2u 18446744073709551615u)
def proposeRegMax : Option Flag := map (fun (r : Prod State (List Out)) => u256Eq (proposal (first r)) 18446744073709551615u) (propose e11 init 16u 2u 3u 4u 3u 18446744073709551615u)
def proposeCapWide : Option Flag := map (fun (r : Prod State (List Out)) => u256Eq (proposal (first r)) 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu) (propose e11 init 16u 2u 3u 4u 0u 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu)
def proposeClassWide : Option Flag := map (fun (r : Prod State (List Out)) => u256Eq (proposal (first r)) 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu) (propose e11 init 16u 2u 3u 4u 1u 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu)
